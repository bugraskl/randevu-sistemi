# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_NAME="Randevu Yönetim Sistemi"
APP_DOMAIN=yourdomain.com

# Database Configuration
DB_HOST=localhost
DB_NAME=randevu_db
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# NetGSM SMS Configuration
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=

# SMS Configuration
SMS_ENABLED=true
SMS_SECURITY_TOKEN=

# Debug Settings
SMS_DEBUG=false
ENABLE_LOGGING=true

# Timezone
APP_TIMEZONE=Europe/Istanbul

# Bildirim Ayarları
ADMIN_NOTIFICATION_PHONE=05XXXXXXXXX

# Security Settings (Production için değiştirilmeli)
SECURITY_KEY=
SESSION_LIFETIME=1440

# Seans (varsayılanlar; uygulamada Menü > Seans Ayarları'ndan değiştirilebilir)
SEANS_SURESI_DK=50

# Danışanın randevu teyit sayfasında görünen uzman adı (isteğe bağlı), ör. Psk. Ad Soyad
PRACTITIONER_NAME=

# Ödeme alındığında gelir bildirimi gönderilecek webhook (isteğe bağlı; boşsa kapalı)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_USER=
