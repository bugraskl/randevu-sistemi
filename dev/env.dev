# Yerel geliştirme ortamı — yalnızca `php -S` (dev/router.php) ile okunur.
# Production `env` dosyasına dokunmaz. SMS ve webhook bilerek kapalıdır.
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8091/
APP_NAME=Randevu Yönetim Sistemi
APP_DOMAIN=localhost

DB_HOST=localhost
DB_NAME=randevu_dev
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=

SMS_ENABLED=false
SMS_SECURITY_TOKEN=dev-only
CONFIRMATION_SMS_ENABLED=false
SMS_DEBUG=true
ENABLE_LOGGING=false

APP_TIMEZONE=Europe/Istanbul
ADMIN_NOTIFICATION_PHONE=

SECURITY_KEY=dev-only-not-a-secret
SESSION_LIFETIME=1440
API_TOKEN=dev-only

N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
