AddType application/manifest+json .json
AddType application/javascript .js

# Hassas dosyalar web'den erişilemez: ayarlar (env), yedek arşivleri, kayıtlar, SQL dökümleri
<FilesMatch "^(env|env\..*|error_log|.*\.(sql|zip|log|md|bak|sh))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Kayıt, veritabanı ve geliştirme klasörleri
<IfModule mod_alias.c>
    RedirectMatch 403 ^/(logs|database|sql|dev|graft)(/|$)
</IfModule>

<IfModule mod_headers.c>
    Header set Service-Worker-Allowed "/"
</IfModule>

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# PHP uzantısını gizle
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]
